<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RefractorForge.Formats</RootNamespace>
    <!-- The spine has ZERO external dependencies on purpose: it stays portable
         to any UI shell (WPF, Avalonia, Silk.NET, a CLI, tests) and never drags
         engine assumptions into the data model. -->
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>RefractorForge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- The Meme menu class tables, generated by tools/meme/make_resource.py from tools/meme/meme_schema.json. -->
    <EmbeddedResource Include="Menu\MemeSchema.json" LogicalName="RefractorForge.Formats.Menu.MemeSchema.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MiniLZO" Version="1.0.1" />
  </ItemGroup>

</Project>
