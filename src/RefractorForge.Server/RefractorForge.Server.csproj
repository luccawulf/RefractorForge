<Project Sdk="Microsoft.NET.Sdk">

  <!-- The central collaboration relay as its own program: no editor, no window, no GL, no audio. Runs on a
       VPS (Linux or Windows) that every editor connects OUT to, so nobody forwards a port at home. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>RefractorForge.Server</AssemblyName>
    <RootNamespace>RefractorForge.Server</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RefractorForge.Formats\RefractorForge.Formats.csproj" />
    <ProjectReference Include="..\RefractorForge.Render\RefractorForge.Render.csproj" />
    <ProjectReference Include="..\RefractorForge.Collab\RefractorForge.Collab.csproj" />
  </ItemGroup>

</Project>
