<?xml version="1.0" encoding="utf-8"?>
<!--
  Public BETA release profile: bundle the managed assemblies into a single self-contained .exe.

  This affects PUBLISH ONLY. A plain `dotnet build` (and therefore the normal development loop, where the three
  RefractorForge DLLs are copied into a launch folder that also holds the user's own TerrainTextures pack and
  refractorforge.json) is completely untouched - a .pubxml is read only when it is named explicitly:

      dotnet publish src/RefractorForge.Viewer -c Release -p:PublishProfile=Beta

  Notes on the choices:
   * SelfContained + win-x64  - a BF modder should not have to install the .NET 8 Desktop Runtime first. Costs
                                size, but this is a one-file download for end users.
   * IncludeNativeLibrariesForSelfExtract - Silk.NET's GLFW and NAudio ship native .dll's; without this they stay
                                loose beside the exe and the "single file" claim is false. They are extracted to a
                                temp folder on first run, which is why startup is slightly slower than the dev build.
   * PublishTrimmed is deliberately OFF - ImGui, WinForms and System.Text.Json all resolve types by reflection, and
                                trimming silently removes them (the failure shows up at runtime, not at build).
   * PublishReadyToRun OFF    - R2R roughly doubles the output size for a startup win that does not matter here.

  CONTENT FILES (lang\, brushes\, textures\, TerrainTextures\, ffmpeg\, the icon and splash) are NOT bundled into
  the exe - they stay as loose files beside it ON PURPOSE, so translators can edit lang\ja.json and users can drop
  their own tiles into TerrainTextures\ without a rebuild.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\Beta\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
