<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- No NuGet deps: mesh + camera + a software rasterizer on System.Numerics (in-box).
         The GPU viewer reuses TerrainMesh and Camera; the rasterizer is a headless
         preview/verification path. -->
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>RefractorForge.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RefractorForge.Formats\RefractorForge.Formats.csproj" />
  </ItemGroup>

</Project>
