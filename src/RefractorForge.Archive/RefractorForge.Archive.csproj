<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: a file browser has no business opening a console window. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>RefractorForgeArchive</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A texture.rfa is ~2 GiB and single entries run to tens of MB, so never the 2 GB-capped 32-bit host. -->
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Audio preview. MUST stay on the high-level AudioFileReader + WaveOutEvent path: a hand-rolled
         mixer/sample-provider pipeline silently corrupted decoded audio in this codebase before. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole point of this program: the RFA reader/writer that is verified byte-exact, rather than
         a second implementation that can drift. Render supplies the DDS/TGA decoders for previews. -->
    <ProjectReference Include="..\RefractorForge.Formats\RefractorForge.Formats.csproj" />
    <ProjectReference Include="..\RefractorForge.Render\RefractorForge.Render.csproj" />
  </ItemGroup>

</Project>
