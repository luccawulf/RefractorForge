<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RefractorForge.Formats\RefractorForge.Formats.csproj" />
    <ProjectReference Include="..\RefractorForge.Render\RefractorForge.Render.csproj" />
    <ProjectReference Include="..\RefractorForge.Collab\RefractorForge.Collab.csproj" />
    <ProjectReference Include="..\RefractorForge.Mcp\RefractorForge.Mcp.csproj" />
    <!-- The editor's Theme is driven through a headless Dear ImGui context (no window, no GPU) so a push/pop
         imbalance in a helper is caught here rather than as a corrupted panel on someone's screen. -->
    <ProjectReference Include="..\RefractorForge.Viewer\RefractorForge.Viewer.csproj" />
  </ItemGroup>
</Project>
