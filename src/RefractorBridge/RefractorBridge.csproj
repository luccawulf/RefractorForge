<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RefractorBridge</RootNamespace>
    <AssemblyName>rbridge</AssemblyName>
    <!-- Standalone by design: the converter is its own exe so it can be run on a mod tree without the
         editor anywhere in sight. It still REFERENCES Formats rather than re-implementing RFA/mesh I/O -
         the one-off Al Nas tools re-rolled the RFA writer and paid for it with three "the map crashes"
         rounds that were purely container corruption. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RefractorForge.Formats\RefractorForge.Formats.csproj" />
  </ItemGroup>

</Project>
